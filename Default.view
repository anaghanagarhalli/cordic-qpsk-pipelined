# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name MAX_TIMING -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name MIN_TIMING -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_constraint_mode -name PIP_CONSTRAINT -sdc_files {output/constraints/qpsk_pipelined_top_synth.sdc}
create_delay_corner -name WORST_CASE -library_set {MAX_TIMING}
create_delay_corner -name BEST_CASE -library_set {MIN_TIMING}
create_analysis_view -name BEST -constraint_mode {PIP_CONSTRAINT} -delay_corner {BEST_CASE}
create_analysis_view -name WORST -constraint_mode {PIP_CONSTRAINT} -delay_corner {WORST_CASE}
set_analysis_view -setup {WORST} -hold {BEST}
